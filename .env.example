# Copia este archivo como ".env" y completa los valores reales ahí.
# El archivo ".env" nunca se sube al repositorio, ya está excluido
# en .gitignore.

# Credencial de la API de Google Gemini.
# Se obtiene en https://aistudio.google.com/apikey
AI_API_KEY=

# Modelo de Gemini que se va a consultar.
# El README indica cuál se usó en este proyecto.
AI_MODEL=""